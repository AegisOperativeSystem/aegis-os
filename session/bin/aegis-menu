#!/bin/bash
set -eu

tty=/dev/tty
logo=/usr/share/aegis/logo.txt
choice=0
options=("Install" "Repair" "Live desktop")
blurbs=("Erase a disk and install Aegis OS" "Restore an existing Aegis installation" "Open GNOME and keep this session")
keys=(install repair desktop)

teal=$'\033[96m'
dim=$'\033[90m'
text=$'\033[97m'
sel=$'\033[30;106m'
reset=$'\033[0m'
hide=$'\033[?25l'
show=$'\033[?25h'

cleanup() {
  printf '\033[2J\033[H%s%s' "$show" "$reset" >"$tty"
}
trap cleanup EXIT INT TERM

draw() {
  local i mark
  printf '\033[2J\033[H%s' "$hide" >"$tty"
  if command -v setfont >/dev/null 2>&1; then
    setfont ter-u16n >/dev/null 2>&1 || true
  fi
  printf '\033%%G' >"$tty"
  printf '%s' "$teal" >"$tty"
  if [[ -f $logo ]]; then
    cat "$logo" >"$tty"
  else
    printf 'AEGIS OS\n' >"$tty"
  fi
  printf '%s\n' "$reset" >"$tty"
  printf '%s  Choose what to do%s\n\n' "$dim" "$reset" >"$tty"
  for i in 0 1 2; do
    if [[ $i -eq $choice ]]; then
      mark=">"
      printf '%s  %s  %s  %s%s\n' "$sel" "$mark" "${options[$i]}" "$reset" "" >"$tty"
    else
      mark=" "
      printf '%s  %s  %s%s\n' "$text" "$mark" "${options[$i]}" "$reset" >"$tty"
    fi
    printf '%s       %s%s\n' "$dim" "${blurbs[$i]}" "$reset" >"$tty"
  done
  printf '\n%s  Up and down to move. Enter to confirm. 1, 2 or 3 select.%s\n' "$dim" "$reset" >"$tty"
}

read_key() {
  local key rest
  IFS= read -rsn1 key <"$tty" || key=
  if [[ $key == $'\e' ]]; then
    IFS= read -rsn2 -t 1 rest <"$tty" || rest=
    printf '%s' "$key$rest"
    return
  fi
  printf '%s' "$key"
}

draw
while true; do
  key=$(read_key || true)
  case $key in
    $'\e[A' | k | K) choice=$(((choice + 2) % 3)) ;;
    $'\e[B' | j | J) choice=$(((choice + 1) % 3)) ;;
    1) choice=0 ;;
    2) choice=1 ;;
    3) choice=2 ;;
    '' | $'\n')
      printf '%s\n' "${keys[$choice]}"
      exit 0
      ;;
    *) continue ;;
  esac
  if [[ $key == 1 || $key == 2 || $key == 3 ]]; then
    printf '%s\n' "${keys[$choice]}"
    exit 0
  fi
  draw
done
