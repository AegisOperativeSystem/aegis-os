#!/bin/sh
if [ -f "${HOME}/.config/aegis/xprofile" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.config/aegis/xprofile"
elif [ -f /etc/vconsole.conf ]; then
  keymap=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf | head -n 1)
  if [ -n "${keymap}" ]; then
    setxkbmap "${keymap}"
  fi
fi
export XDG_CURRENT_DESKTOP=GNOME-Flashback:GNOME
export XDG_SESSION_DESKTOP=gnome-flashback-metacity
exec gnome-session --session=gnome-flashback-metacity
