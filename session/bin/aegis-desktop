#!/bin/sh
layout=
if [ -f "${HOME}/.config/aegis/keymap" ]; then
  layout=$(head -n 1 "${HOME}/.config/aegis/keymap")
elif [ -f /etc/vconsole.conf ]; then
  layout=$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf | head -n 1)
fi
if [ -n "${layout}" ]; then
  export XKB_DEFAULT_LAYOUT="${layout}"
fi

if [ -f /etc/environment.d/50-aegis-gl.conf ]; then
  # shellcheck disable=SC1091
  set -a
  . /etc/environment.d/50-aegis-gl.conf
  set +a
fi

export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1

names=
for name in LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE MUTTER_DEBUG_DISABLE_HW_CURSORS XKB_DEFAULT_LAYOUT GDK_BACKEND QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND; do
  eval "value=\${${name}-}"
  if [ -n "${value}" ]; then
    names="${names} ${name}"
  fi
done
if [ -n "${names}" ]; then
  # shellcheck disable=SC2086
  systemctl --user import-environment ${names} || true
fi

exec gnome-session --session=gnome
