#!/bin/sh
set -eu
if [ -x /usr/share/aegis/write-os-release ]; then
  /usr/share/aegis/write-os-release
fi
if ! id live >/dev/null 2>&1; then
  useradd -m -G wheel,video,audio,input,storage -s /bin/bash live
fi
passwd -d live
systemctl mask gdm.service
systemctl enable greetd.service
systemctl enable NetworkManager.service
systemctl enable aegis-live-setup.service
